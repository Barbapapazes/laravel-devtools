{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm --dir packages/laravel-devtools build && vite build",
        "dev": "pnpm --dir packages/laravel-devtools build && concurrently --kill-others \"pnpm --dir packages/laravel-devtools dev\" \"pnpm --dir packages/laravel-devtools dev:models\" \"pnpm --dir packages/laravel-devtools dev:node\" \"vite\"",
        "typecheck": "pnpm --dir packages/laravel-devtools typecheck"
    },
    "devDependencies": {
        "@barbapapazes/laravel-devtools": "file:packages/laravel-devtools",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/devtools": "^0.7.6",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
