{
    "name": "barbapapazes/laravel-devtools",
    "description": "Laravel feeds for the route and model inspector devtools",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Devtools\\LaravelDevtools\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Devtools\\LaravelDevtools\\Laravel\\LaravelDevtoolsServiceProvider"]
        }
    }
}