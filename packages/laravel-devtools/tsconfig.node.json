{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022", "DOM"],
        "types": ["node"],
        "rootDir": "src/node",
        "outDir": "dist/node",
        "declaration": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["src/node/**/*.ts"]
}